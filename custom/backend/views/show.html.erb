<!DOCTYPE html>
<html>
  <head>
    <title><%= @global_config['INSTALLATION_NAME'] %></title>
    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
    <script>
      window.chatwootWebChannel = {
        avatarUrl: '<%= @web_widget.inbox.avatar_url %>',
        hasAConnectedAgentBot: '<%= @web_widget.inbox.agent_bot&.name %>',
        locale: '<%= @web_widget.account.locale %>',
        websiteName: '<%= @web_widget.inbox.name %>',
        websiteToken: '<%= @web_widget.website_token %>',
        welcomeTagline: <%= @web_widget.welcome_tagline.to_json.html_safe %>,
        welcomeTitle: '<%= @web_widget.welcome_title %>',
        widgetColor: '<%= @web_widget.widget_color %>',
        portal: <%= @web_widget.inbox.portal.to_json.html_safe %>,
        enabledFeatures: <%= @web_widget.selected_feature_flags.to_json.html_safe %>,
        enabledLanguages: <%= available_locales_with_name.to_json.html_safe %>,
        replyTime: '<%= @web_widget.reply_time %>',
        preChatFormEnabled: <%= @web_widget.pre_chat_form_enabled %>,
        preChatFormOptions: <%= @web_widget.pre_chat_form_options.to_json.html_safe %>,
        workingHoursEnabled: <%= @web_widget.inbox.working_hours_enabled %>,
        csatSurveyEnabled: <%= @web_widget.inbox.csat_survey_enabled %>,
        workingHours: <%= @web_widget.inbox.working_hours.to_json.html_safe %>,
        outOfOfficeMessage: <%= @web_widget.inbox.out_of_office_message.to_json.html_safe %>,
        utcOffset: '<%= ActiveSupport::TimeZone[@web_widget.inbox.timezone].now.formatted_offset %>',
        timezone: '<%= @web_widget.inbox.timezone %>',
        allowMessagesAfterResolved: <%= @web_widget.inbox.allow_messages_after_resolved %>,
        disableBranding: <%= @web_widget.inbox.account.feature_enabled?('disable_branding') %>,
        enableElevenLabsVoice: <%= @web_widget.elevenlabs_voice? %>,
        elevenLabsAgentId: '<%= @web_widget.elevenlabs_agent_id.to_s %>',
        voiceAgentEnabled: <%= (@web_widget.elevenlabs_voice? || (@web_widget.voice_agent_api_key.present? && @web_widget.voice_agent_provider.present?)) %>,
        voiceAgentProvider: '<%= @web_widget.voice_agent_provider.to_s %>',
        voiceAgentConfigData: <%= (@web_widget.voice_agent_config_data || {}).to_json.html_safe %>,
        customBrandingText: <%= @web_widget.custom_branding_text.to_json.html_safe %>,
        customBrandingUrl: <%= @web_widget.custom_branding_url.to_json.html_safe %>,
        customBubbleIconUrl: <%= @web_widget.custom_bubble_icon_url.to_json.html_safe %>,
        customBubbleIconSize: <%= (@web_widget.custom_bubble_icon_size || 60).to_json.html_safe %>,
        widgetBgColor: <%= @web_widget.widget_bg_color.to_json.html_safe %>,
        widgetBgImageUrl: <%= @web_widget.widget_bg_image_url.to_json.html_safe %>,
        widgetFontFamily: <%= @web_widget.widget_font_family.to_json.html_safe %>,
        welcomeHeadingColor: <%= @web_widget.welcome_heading_color.to_json.html_safe %>,
        welcomeHeadingSize: <%= (@web_widget.welcome_heading_size || 0).to_json.html_safe %>,
        welcomeTaglineColor: <%= @web_widget.welcome_tagline_color.to_json.html_safe %>,
        welcomeTaglineSize: <%= (@web_widget.welcome_tagline_size || 0).to_json.html_safe %>,
        onlineStatusColor: <%= @web_widget.online_status_color.to_json.html_safe %>,
        replyTimeColor: <%= @web_widget.reply_time_color.to_json.html_safe %>,
        ctaBgColor: <%= @web_widget.cta_bg_color.to_json.html_safe %>,
        ctaTextColor: <%= @web_widget.cta_text_color.to_json.html_safe %>,
        botBubbleBgColor: <%= @web_widget.bot_bubble_bg_color.to_json.html_safe %>,
        botBubbleTextColor: <%= @web_widget.bot_bubble_text_color.to_json.html_safe %>,
        userBubbleBgColor: <%= @web_widget.user_bubble_bg_color.to_json.html_safe %>,
        userBubbleTextColor: <%= @web_widget.user_bubble_text_color.to_json.html_safe %>,
        inputFocusColor: <%= @web_widget.input_focus_color.to_json.html_safe %>,
        messageFontSize: <%= (@web_widget.message_font_size || 0).to_json.html_safe %>,
      }
      window.chatwootPubsubToken = '<%= @contact_inbox.pubsub_token %>'
      window.authToken = '<%= @token %>'
      window.globalConfig = <%= raw @global_config.to_json %>
    </script>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'widget' %>
  </head>
  <body>
    <div id="app" class="h-full"></div>
    <%= yield %>
  </body>
</html>
